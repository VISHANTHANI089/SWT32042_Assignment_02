<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Vendor Details"
                android:textColor="#58287F"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Select Vendor ID Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Select Vendor ID"
            android:textColor="#343A40"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Vendor ID Dropdown (Spinner) -->
        <Spinner
            android:id="@+id/spinnerVendorId"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            />

        <!-- Vendor Name Input -->
        <EditText
            android:id="@+id/etEditVendorName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_simple_input"
            android:hint="Vendor Name"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp"
            android:textColor="#212121"
            android:textSize="16sp" />

        <!-- Vendor Phone Input -->
        <EditText
            android:id="@+id/etEditVendorPhone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_simple_input"
            android:hint="Phone Number"
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            android:textColor="#212121"
            android:textSize="16sp" />

        <!-- Vendor Address Input -->
        <EditText
            android:id="@+id/etEditVendorAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_simple_input"
            android:gravity="top|start"
            android:hint="Address"
            android:inputType="textPostalAddress|textMultiLine"
            android:minLines="3"
            android:padding="16dp"
            android:textColor="#212121"
            android:textSize="16sp" />

        <!-- Update Button -->
        <Button
            android:id="@+id/btnUpdateVendor"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#58287F"
            android:text="Update Vendor"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:cornerRadius="8dp" />

    </LinearLayout>
</ScrollView>